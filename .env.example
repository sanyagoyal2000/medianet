# All optional. Without ANTHROPIC_API_KEY every agent runs from the committed cache.
ANTHROPIC_API_KEY=
# live | cached  (default: live if ANTHROPIC_API_KEY is set, else cached)
DEMO_MODE=
# Neon Postgres (Vercel Marketplace). Without it, an in-memory store seeded from data/seed is used.
DATABASE_URL=
# If set, /api/mcp requires "Authorization: Bearer <MCP_AUTH_TOKEN>"
MCP_AUTH_TOKEN=
# Public base URL, used in MCP instructions and ShopBuddy -> API calls (falls back to request origin)
NEXT_PUBLIC_APP_URL=
